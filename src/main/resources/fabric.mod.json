{
	"schemaVersion": 1,
	"id": "kasuri",
	"version": "${version}",
	"name": "Kasuri",
	"description": "Adds the Block Brush, a building tool that repaints blocks while keeping their shape and state.",
	"authors": [
		"ookasamoti"
	],
	"license": "CC0-1.0",
	"icon": "assets/kasuri/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.ookasamoti.kasuri.Kasuri"
		],
		"client": [
			"com.ookasamoti.kasuri.client.KasuriClient"
		]
	},
	"mixins": [
		{
			"config": "kasuri.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
